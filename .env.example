# Salin berkas ini menjadi .env, lalu isi dengan pengaturanmu sendiri.
# Jangan pernah mengunggah berkas .env yang sudah diisi ke repositori.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=katalog_warung

# Nomor WhatsApp warung, format internasional tanpa tanda +, contoh 6281234567890.
# Dipakai tombol "Pesan via WhatsApp" di halaman keranjang.
WA_NOMOR=6281234567890
